# Configuración del servidor MCP de MailerUp.
# Copia este fichero a .env y rellena tus valores (NO lo subas al repo).

# URL pública de tu instancia MailerUp (usa https en producción).
MAILERUP_BASE_URL=https://newsletter.example.com

# Credenciales de una cuenta del panel. El login es POR EMAIL. Para gestión
# total (usuarios, API keys, backup SQLite) usa una cuenta admin.
MAILERUP_EMAIL=admin@tudominio.com
MAILERUP_PASSWORD=cambia-esto

# Opcionales:
# MAILERUP_VERIFY_SSL=true      # pon false solo para certificados autofirmados
# MAILERUP_TIMEOUT=120          # segundos
# MAILERUP_BACKUP_DIR=~/mailerup-backups
