SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite por defecto (deja vacío o comenta para usar db.sqlite3 en backend/)
# DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nº de proxies de confianza delante de Django (nginx) para el cálculo de IP
# real en el throttling de login. 1 = un único nginx delante de Django
# (despliegue nativo). Súbelo si añades más saltos de proxy (p.ej. nginx del
# host + nginx del contenedor en el despliegue Docker).
NUM_PROXIES=1

# Envío por SMTP (se puede configurar también desde Ajustes en la web)
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=465
# SMTP_USER=tu@email.com
# SMTP_PASSWORD=
# SMTP_USE_SSL=true
DEFAULT_FROM_EMAIL=tu@email.com
DEFAULT_FROM_NAME=Mailerup

# Webhook genérico de compra (POST /api/webhooks/purchase/, cabecera
# X-Webhook-Secret: <este valor>). Vacío = endpoint desactivado (404).
# Genera un valor con: openssl rand -hex 32
PURCHASE_WEBHOOK_SECRET=

# Cada cuántos segundos el scheduler recalcula awareness_level según
# aperturas/clics nuevos (ver apps/subscribers/scoring.py).
SCORING_INTERVAL_SECONDS=300
